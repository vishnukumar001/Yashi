# ── Primary: Google Gemini (voice/live + chat) ──────────────────────────────
# Get a key at: https://aistudio.google.com/apikey
# This is the only key required for Yashi's core voice + chat experience.
GEMINI_API_KEY="your_gemini_api_key_here"
GOOGLE_API_KEY="your_gemini_api_key_here"

# ── Optional: Preferred User Name (also configurable in UI) ─────────────────
USER_NAME="YourName"

# ── NVIDIA Nemotron (optional — text reasoning, memory consolidation) ────────
# Get a key at: https://build.nvidia.com/explore/discover
# Used for text-based tasks (memory consolidation, fallback reasoning).
# Does NOT support live audio streaming.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# ── AI Provider Selection ───────────────────────────────────────────────────
# Controls which AI provider is tried first for text-based tasks (memory
# consolidation, fallback reasoning). The voice/live API ALWAYS uses Gemini.
# Supported values: gemini, nvidia, groq, openrouter
# Default: gemini
# AI_PROVIDER=gemini

# ── Groq (optional — fast inference for quick text tasks) ───────────────────
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# ── OpenRouter (optional — multi-model gateway) ─────────────────────────────
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# ── App URL (auto-injected by AI Studio in hosted deployments) ──────────────
APP_URL="MY_APP_URL"
